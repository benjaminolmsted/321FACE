{
  "expo": {
    "name": "321FACE",
    "slug": "321FACE",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/321FACE_SPLASH.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/MASKS_ON_MARBLE.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f5f5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.x321FACE",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for the 321FACE game.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/321FACE_SPLASH.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.anonymous.x321FACE",
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006"
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 321FACE to access your camera to take photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow 321FACE to save videos to your photo library.",
          "savePhotosPermission": "Allow 321FACE to save videos to your photo library.",
          "granularPermissions": []
        }
      ],
      "./plugins/withMediaPipeAssets",
      "./plugins/withAsyncStorageMaven",
      "./plugins/withFfmpegFlatDir",
      "./plugins/withDebugAppName",
      "./plugins/withDebugApplicationId",
      ["react-native-share", {}],
      "./plugins/withReactNativeShare",
      "./plugins/withAndroidReleaseKeystore"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
