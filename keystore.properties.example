# Copy this file to android/keystore.properties after `npx expo prebuild --platform android`
# (the android/ folder is gitignored; do not commit keystore.properties or your .jks).
#
# Create an upload key (example; adjust paths and passwords):
#   keytool -genkeypair -v -keystore upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Place upload-key.jks in the android/ directory (next to this file's target).
#
# For Google Play, use Play App Signing; this .jks is your *upload* key.

storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-key.jks
